# TainerHub hub: web UI + API (:8585, optionally behind a reverse proxy) and agent gateway (:7443, mTLS)
# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM node:26-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ARG TARGETOS TARGETARCH VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X github.com/prezmc/tainerhub/internal/version.Version=${VERSION}" \
      -o /out/tainerhub ./cmd/tainerhub \
 && mkdir -p /out/data /out/share

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/tainerhub /tainerhub
COPY --from=build --chown=65532:65532 /out/data /data
# shared with the hub's own agent: the hub leaves its join token here
COPY --from=build --chown=65532:65532 /out/share /share
USER nonroot:nonroot
VOLUME /data /share
EXPOSE 8585 7443
ENTRYPOINT ["/tainerhub"]

# TainerHub agent: runs on every Docker host and connects out to the hub.
# syntax=docker/dockerfile:1

# The official, statically linked `docker compose` binary for running stacks.
# Dependabot (docker ecosystem) keeps this tag and digest current.
FROM docker/compose-bin:v5.8.0@sha256:c9f99a4efa43ca83e5acc056da938c38504010c10a2dd804569032be5d3b0dd5 AS compose

FROM --platform=$BUILDPLATFORM golang:1-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ARG TARGETOS TARGETARCH VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X github.com/prezmc/tainerhub/internal/version.Version=${VERSION}" \
      -o /out/tainerhub-agent ./cmd/tainerhub-agent

# Runs as root because it needs the Docker socket (which is root-equivalent).
FROM gcr.io/distroless/static-debian12:latest@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /out/tainerhub-agent /tainerhub-agent
COPY --from=compose /docker-compose /usr/local/bin/docker-compose
VOLUME /data
ENTRYPOINT ["/tainerhub-agent"]
